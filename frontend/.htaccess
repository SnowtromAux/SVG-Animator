Options -MultiViews
RewriteEngine On
RewriteBase /svganimator/frontend/

# 1) Реални файлове/папки не ги пипаме
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2) /login -> src/views/login/index.html (вътрешно)
RewriteCond %{DOCUMENT_ROOT}/svganimator/frontend/src/views/$1/index.html -f
RewriteRule ^(.+?)/?$ src/views/$1/index.html [L]
