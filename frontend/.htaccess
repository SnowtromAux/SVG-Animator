Options -MultiViews
RewriteEngine On

# 1) Реални файлове/папки не ги пипаме
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2) /login -> src/views/login/index.html (и работи за вложени: /platform/editor -> src/views/platform/editor/index.html)
RewriteCond %{CONTEXT_DOCUMENT_ROOT}/src/views/$1/index.html -f
RewriteRule ^(.+?)/?$ src/views/$1/index.html [L]
